{
  "name": "setup-aspire",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action to install and cache the Aspire CLI",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/timheuer/setup-aspire.git"
  },
  "author": "Tim Heuer",
  "license": "MIT",
  "keywords": [
    "github-action",
    "aspire",
    "cli",
    "setup"
  ],
  "bugs": {
    "url": "https://github.com/timheuer/setup-aspire/issues/"
  },
  "homepage": "https://github.com/timheuer/setup-aspire#readme",
